<component>
  <api>
    <prop name="icon" type="string"/>
    <prop name="label" type="string"/>
    <prop name="index" type="int"/>
  </api>
  <view extends="lv_button" width="100%" height="84" flex_flow="column"
        style_flex_main_place="center" style_flex_cross_place="center">
    <style name="nav"/>
    <style name="nav_on" selector="checked"/>
    <subject_set_int_event trigger="clicked" subject="page" value="$index"/>
    <bind_state_if_eq subject="page" state="checked" ref_value="$index"/>
    <lv_label text="$icon" style_text_font="font_xl"/>
    <lv_label text="$label" style_text_font="font_s"/>
  </view>
</component>
