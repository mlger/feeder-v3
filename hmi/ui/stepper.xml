<!-- [-] value [+] bound to an int subject. `display` is the subject shown. -->
<component>
  <api>
    <prop name="title" type="string"/>
    <prop name="subject" type="string"/>
    <prop name="display" type="string"/>
    <prop name="fmt" type="string" default="%d"/>
    <prop name="step" type="int" default="1"/>
    <!-- Minus the step. XML cannot negate a parameter ("-$step" is not
         substituted and reads as 0), so a stepper whose step is not 1 must
         pass this as well. tests: sim checks every stepper both ways. -->
    <prop name="neg_step" type="int" default="-1"/>
    <prop name="min" type="int" default="0"/>
    <prop name="max" type="int" default="100"/>
    <prop name="rollover" type="bool" default="false"/>
    <prop name="w" type="int" default="122"/>
  </api>
  <view extends="lv_obj" width="$w" height="content" flex_flow="column"
        style_flex_cross_place="center" style_pad_row="4" scrollable="false">
    <style name="plain"/>
    <lv_label text="$title" style_text_font="font_s">
      <style name="muted"/>
    </lv_label>
    <lv_obj width="100%" height="content" flex_flow="row" style_flex_cross_place="center"
            style_flex_main_place="space_between" scrollable="false">
      <style name="plain"/>
      <lv_button width="36" height="40" style_pad_all="0">
        <subject_increment_event trigger="clicked" subject="$subject" step="$neg_step"
                                 min_value="$min" max_value="$max" rollover="$rollover"/>
        <subject_increment_event trigger="long_pressed_repeat" subject="$subject" step="$neg_step"
                                 min_value="$min" max_value="$max" rollover="$rollover"/>
        <lv_label text="-" align="center" style_text_font="font_l"/>
      </lv_button>
      <lv_label bind_text="$display" bind_text-fmt="$fmt" style_text_font="font_m"/>
      <lv_button width="36" height="40" style_pad_all="0">
        <subject_increment_event trigger="clicked" subject="$subject" step="$step"
                                 min_value="$min" max_value="$max" rollover="$rollover"/>
        <subject_increment_event trigger="long_pressed_repeat" subject="$subject" step="$step"
                                 min_value="$min" max_value="$max" rollover="$rollover"/>
        <lv_label text="+" align="center" style_text_font="font_l"/>
      </lv_button>
    </lv_obj>
  </view>
</component>
