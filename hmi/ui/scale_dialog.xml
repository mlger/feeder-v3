<!-- Set-up of the optional scale under the hopper: zero it, then set its span. -->
<component>
  <view extends="lv_obj" width="100%" height="100%" scrollable="false">
    <style name="backdrop"/>
    <lv_obj width="620" height="content" align="center" flex_flow="column"
            style_pad_all="18" style_pad_row="12" scrollable="false">
      <lv_label bind_text="cal_title" style_text_font="font_l"/>
      <lv_label bind_text="scale_text" width="100%" long_mode="wrap"/>
      <lv_label bind_text="scale_reading" style_text_font="font_l"/>
      <row style_flex_main_place="space_between">
        <lv_button width="150" height="48">
          <event_cb callback="on_scale_zero" trigger="clicked"/>
          <lv_label text="1. Zero" align="center"/>
        </lv_button>
        <stepper title="Known weight" w="170" subject="scale_known" display="scale_known_txt" fmt="%s"
                 step="10" neg_step="-10" min="10" max="2000"/>
        <lv_button width="150" height="48">
          <event_cb callback="on_scale_span" trigger="clicked"/>
          <lv_label text="2. Set weight" align="center"/>
        </lv_button>
      </row>
      <row style_flex_main_place="end">
        <lv_button width="130" height="48">
          <style name="quiet"/>
          <event_cb callback="on_cal_cancel" trigger="clicked"/>
          <lv_label text="Close" align="center"/>
        </lv_button>
      </row>
    </lv_obj>
  </view>
</component>
