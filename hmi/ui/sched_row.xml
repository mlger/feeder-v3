<component>
  <api>
    <prop name="time" type="string"/>
    <prop name="days" type="string"/>
    <prop name="portion" type="string"/>
    <prop name="enabled" type="bool" default="true"/>
  </api>
  <view extends="lv_obj" width="100%" height="content" flex_flow="row"
        style_flex_cross_place="center" style_pad_all="10" style_pad_column="12" scrollable="false">
    <lv_label text="$time" style_text_font="font_xl" width="96"/>
    <col flex_grow="1" width="10" style_pad_row="2">
      <lv_label text="$days"/>
      <lv_label text="$portion">
        <style name="muted"/>
      </lv_label>
    </col>
    <lv_switch checked="$enabled" width="60" height="32">
      <event_cb callback="on_sched_toggle" trigger="value_changed"/>
    </lv_switch>
    <lv_button width="52" height="44" style_pad_all="0">
      <event_cb callback="on_sched_edit" trigger="clicked"/>
      <lv_label text="&#xF304;" align="center"/>
    </lv_button>
    <lv_button width="52" height="44" style_pad_all="0">
      <style name="danger"/>
      <event_cb callback="on_sched_delete" trigger="clicked"/>
      <lv_label text="&#xF2ED;" align="center"/>
    </lv_button>
  </view>
</component>
