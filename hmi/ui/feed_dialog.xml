<!-- Feed now: pick the amount, in grams on a calibrated feeder, otherwise in pulses. -->
<component>
  <view extends="lv_obj" width="100%" height="100%" scrollable="false">
    <style name="backdrop"/>
    <lv_obj width="560" height="content" align="center" flex_flow="column"
            style_pad_all="18" style_pad_row="12" scrollable="false">
      <lv_label bind_text="fd_title" style_text_font="font_l"/>
      <row style_flex_main_place="space_between">
        <stepper title="Amount" w="170" subject="fd_tenths" display="fd_tenths_txt" fmt="%s" min="1" max="600">
          <bind_flag_if_eq subject="fd_cal" flag="hidden" ref_value="0"/>
        </stepper>
        <stepper title="Pulses" subject="fd_pulses" display="fd_pulses" min="1" max="20">
          <bind_flag_if_eq subject="fd_cal" flag="hidden" ref_value="1"/>
        </stepper>
        <lv_label bind_text="fd_note" flex_grow="1" long_mode="wrap" style_text_align="right">
          <style name="muted"/>
        </lv_label>
      </row>
      <row style_flex_main_place="end">
        <lv_button width="130" height="48">
          <style name="quiet"/>
          <event_cb callback="on_fd_cancel" trigger="clicked"/>
          <lv_label text="Cancel" align="center"/>
        </lv_button>
        <lv_button width="130" height="48">
          <event_cb callback="on_fd_feed" trigger="clicked"/>
          <lv_label text="Feed" align="center"/>
        </lv_button>
      </row>
    </lv_obj>
  </view>
</component>
