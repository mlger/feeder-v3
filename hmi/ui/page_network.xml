<component>
  <view extends="lv_obj" width="100%" flex_grow="1" flex_flow="column" style_pad_row="10">
    <style name="plain"/>
    <bind_flag_if_not_eq subject="page" flag="hidden" ref_value="5"/>

    <lv_obj width="100%" height="content" flex_flow="column" style_pad_all="12" style_pad_row="8"
            scrollable="false">
      <row>
        <col flex_grow="1" width="10" style_pad_row="2">
          <lv_label text="Wi-Fi" style_text_font="font_l"/>
          <lv_label bind_text="wifi_status" width="100%" long_mode="dots">
            <style name="muted"/>
          </lv_label>
        </col>
        <lv_button height="44">
          <event_cb callback="on_wifi_scan" trigger="clicked"/>
          <lv_label text="Scan" align="center"/>
        </lv_button>
        <lv_button height="44">
          <event_cb callback="on_wifi_phone" trigger="clicked"/>
          <lv_label text="Use phone" align="center"/>
        </lv_button>
        <lv_button height="44">
          <style name="quiet"/>
          <event_cb callback="on_wifi_forget" trigger="clicked"/>
          <lv_label text="Forget" align="center"/>
        </lv_button>
      </row>
      <lv_obj name="wifi_list" width="100%" height="content" flex_flow="column" style_pad_row="6">
        <style name="plain"/>
      </lv_obj>
    </lv_obj>

    <lv_obj width="100%" height="content" flex_flow="row" style_pad_all="12"
            style_pad_column="16" style_flex_cross_place="center" scrollable="false">
      <col flex_grow="1" width="10" style_pad_row="2">
        <lv_label text="Internet time" style_text_font="font_l"/>
        <lv_label bind_text="ntp_status" width="100%" long_mode="wrap">
          <style name="muted"/>
        </lv_label>
      </col>
      <stepper title="UTC offset" w="160" subject="utc_off" display="utc_txt" fmt="%s"
               step="15" neg_step="-15" min="-720" max="840"/>
      <lv_switch width="60" height="32" bind_checked="ntp_on"/>
    </lv_obj>

    <lv_obj width="100%" height="content" flex_flow="row" style_pad_all="12"
            style_pad_column="16" style_flex_cross_place="center" scrollable="false">
      <col flex_grow="1" width="10" style_pad_row="2">
        <lv_label text="Firmware updates" style_text_font="font_l"/>
        <lv_label bind_text="ota_status" width="100%" long_mode="wrap">
          <style name="muted"/>
        </lv_label>
      </col>
    </lv_obj>
  </view>
</component>
