<component>
  <api>
    <prop name="name" type="string"/>
    <prop name="detail" type="string"/>
    <prop name="state" type="string"/>
    <prop name="state_color" type="color" default="0x8a94a0"/>
  </api>
  <view extends="lv_obj" width="100%" height="content" flex_flow="row"
        style_flex_cross_place="center" style_pad_all="10" style_pad_column="12" scrollable="false">
    <col flex_grow="1" width="10" style_pad_row="2">
      <lv_label text="$name" style_text_font="font_l"/>
      <lv_label text="$detail" style_text_font="font_s">
        <style name="muted"/>
      </lv_label>
    </col>
    <lv_label text="$state" style_text_color="$state_color"/>
    <lv_button height="44">
      <event_cb callback="on_node_rename" trigger="clicked"/>
      <lv_label text="Rename" align="center"/>
    </lv_button>
    <lv_button height="44">
      <style name="danger"/>
      <event_cb callback="on_node_remove" trigger="clicked"/>
      <lv_label text="Remove" align="center"/>
    </lv_button>
  </view>
</component>
