<globals>
  <consts>
    <color name="ok" value="0x2e9e5b"/>
    <color name="warn" value="0xe09a1a"/>
    <color name="bad" value="0xd64545"/>
    <color name="muted" value="0x8a94a0"/>
    <color name="rail_bg" value="0x16202b"/>
    <color name="rail_fg" value="0xd5dde6"/>
    <color name="accent" value="0x2196f3"/>
  </consts>

  <styles>
    <!-- A container that only does layout. -->
    <style name="plain" bg_opa="0" border_width="0" pad_all="0" radius="0" shadow_width="0"/>
    <style name="muted" text_color="#muted"/>
    <style name="nav" bg_opa="0" shadow_width="0" text_color="#rail_fg" radius="10" pad_all="4" pad_row="2"/>
    <style name="nav_on" bg_opa="255" bg_color="#accent" text_color="0xffffff"/>
    <style name="danger" bg_color="#bad"/>
    <style name="quiet" bg_color="#muted"/>
    <style name="day" bg_color="#muted" radius="8" shadow_width="0"/>
    <style name="day_on" bg_color="#accent"/>
    <style name="backdrop" bg_color="0x000000" bg_opa="150" border_width="0" radius="0" pad_all="0"/>
  </styles>
</globals>
