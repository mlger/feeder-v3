<!-- Shown while the Wi-Fi set-up access point is open. -->
<component>
  <view extends="lv_obj" width="100%" height="100%" scrollable="false">
    <style name="backdrop"/>
    <lv_obj width="640" height="content" align="center" flex_flow="row"
            style_pad_all="18" style_pad_column="20" style_flex_cross_place="center" scrollable="false">
      <lv_obj width="content" height="content" style_bg_color="0xffffff" style_bg_opa="255"
              style_pad_all="8" style_radius="6" style_border_width="0" scrollable="false">
        <lv_qrcode name="setup_qr" size="180" dark_color="0x000000" light_color="0xffffff"/>
      </lv_obj>
      <col flex_grow="1" width="10" style_pad_row="10">
        <lv_label text="Set up Wi-Fi from a phone" style_text_font="font_l"/>
        <lv_label bind_text="setup_text" width="100%" long_mode="wrap"/>
        <lv_label text="This closes by itself after 5 minutes." width="100%" long_mode="wrap">
          <style name="muted"/>
        </lv_label>
        <row style_flex_main_place="end">
          <lv_button width="130" height="48">
            <style name="quiet"/>
            <event_cb callback="on_setup_cancel" trigger="clicked"/>
            <lv_label text="Cancel" align="center"/>
          </lv_button>
        </row>
      </col>
    </lv_obj>
  </view>
</component>
